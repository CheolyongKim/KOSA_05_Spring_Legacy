<?xml version="1.0" encoding="UTF-8"?>
<beans  xmlns="http://www.springframework.org/schema/beans"
	    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	    xsi:schemaLocation="http://www.springframework.org/schema/beans 
	                        http://www.springframework.org/schema/beans/spring-beans.xsd">
<bean id="messageBeanImpl" name="m1,m2 m3;m4" class="DI_04_Spring.MessageBeanImpl">
	<constructor-arg value="hong"/>
	<property name="greeting" value="hello"/>
</bean>	                        
</beans>

<!-- 
	객체의 생성과 조립(주입) 담당 > 순수한 자바 (xml과 동일한 역할)
	
	Spring Legacy에서는 
		객체의 생성과 조립을 xml 파일 및 Bean 요소로 한다.
		@Configuration 설정 활용, 자바의 함수를 통해서 객체 생성
		
	<bean id="식별자 이름" name="(별칭 이름) m1,m2 m3;m4"
	별칭의 구분은 ","  ";" 모두 가능
 -->
 
 
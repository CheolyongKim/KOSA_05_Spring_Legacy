<?xml version="1.0" encoding="UTF-8"?>
<beans  xmlns="http://www.springframework.org/schema/beans"
	    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	    xsi:schemaLocation="http://www.springframework.org/schema/beans 
	                        http://www.springframework.org/schema/beans/spring-beans.xsd">
<!-- 
	객체의 생성과 조립(주입) 담당 > 순수한 자바 (xml과 동일한 역할)
	
	Spring Legacy에서는 
		객체의 생성과 조립을 xml 파일 및 Bean 요소로 한다.
		@Configuration 설정 활용, 자바의 함수를 통해서 객체 생성
 -->
 
<bean id="mysqlDAO" class="DI_06_Spring.MysqlDAO">
	
</bean>
<bean id="oracleDAO" class="DI_06_Spring.OracleDAO">
	
</bean>
<bean id="articleService" class="DI_06_Spring.ArticleService">
	<constructor-arg>
		<ref bean="oracleDAO"/> <!-- bean 객체의 주소값을 주입받겠다는 뜻 -->
	</constructor-arg>
</bean>
<bean id="article" class="DI_06_Spring.Article">
	
</bean>
 
</beans> 